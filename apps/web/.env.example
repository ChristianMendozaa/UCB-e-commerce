# Firebase Web SDK values. NEXT_PUBLIC_* variables are embedded by next build.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_ASSISTANT_V2_ENABLED=true

# Server-only upstream URLs for running `pnpm dev` outside Compose.
# Compose overrides these with service DNS names, and Vercel injects them
# through private service bindings.
AUTH_API_URL=http://localhost:8001
ORDERS_API_URL=http://localhost:8002
PRODUCTS_API_URL=http://localhost:8003
CHATBOT_API_URL=http://localhost:8004
IMAGE_SERVICE_BASE_URL=http://localhost:8005
