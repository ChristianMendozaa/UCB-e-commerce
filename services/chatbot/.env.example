OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_RESPONSE_VERBOSITY=low
OPENAI_INPUT_PRICE_PER_M=2.50
OPENAI_CACHED_INPUT_PRICE_PER_M=0.25
OPENAI_OUTPUT_PRICE_PER_M=15.00

# Sent as X-Internal-Token when calling the rag service's /internal/rag/*
# endpoints. Must match services/rag's and services/products' INTERNAL_API_TOKEN
# exactly.
INTERNAL_API_TOKEN=replace-with-internal-api-token
CHAT_ACTION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Local non-Compose defaults. Compose and Vercel bindings override these.
PRODUCTS_API_URL=http://localhost:8003
ORDERS_API_URL=http://localhost:8002
RAG_API_URL=http://localhost:8006

SESSION_COOKIE_NAME=__session
CHAT_SESSION_COOKIE_NAME=ucb_chat_session
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
