OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_INPUT_PRICE_PER_M=2.50
OPENAI_CACHED_INPUT_PRICE_PER_M=0.25
OPENAI_OUTPUT_PRICE_PER_M=15.00

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Shared secret validated by app/deps/internal_auth.py on /internal/rag/*.
# Must match services/products' INTERNAL_API_TOKEN exactly.
INTERNAL_API_TOKEN=replace-with-internal-api-token

# Local non-Compose defaults. Compose and Vercel bindings override these.
PRODUCTS_API_URL=http://localhost:8003
ORDERS_API_URL=http://localhost:8002

SESSION_COOKIE_NAME=__session
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
